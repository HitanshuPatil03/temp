# MRIP configuration template.
#
#   cp .env.example .env
#
# Every value is optional in development — the defaults point at the PostgreSQL
# that `docker compose up -d postgres` starts. In production none of them are
# optional: MRIP_PROFILE=prod makes the application refuse to start rather than
# serve with development defaults (see mrip/config.py::check_production_ready).

# ------------------------------------------------------------------- profile
# dev | test | prod
MRIP_PROFILE=dev

# ----------------------------------------------------------------- datastore
# One PostgreSQL instance is the entire stateful backend: store of record, job
# queue, lexical search, vector search and audit log.
MRIP_DATABASE_URL=postgresql+psycopg://mrip:mrip_dev_only@127.0.0.1:5432/mrip

# Password the compose file gives the postgres container. Change it for anything
# that is not a laptop; `prod` refuses to start while the dev value is in the DSN.
POSTGRES_PASSWORD=mrip_dev_only

# Where the integration suite runs. A separate database, never the dev one.
MRIP_TEST_DATABASE_URL=postgresql+psycopg://mrip:mrip_dev_only@127.0.0.1:5432/mrip_test

# ---------------------------------------------------------------- identity
# Signing key for session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset in development, where a per-process key is generated. REQUIRED in prod:
# a generated key would invalidate every session on restart and differ between
# API replicas.
# MRIP_JWT_SECRET=
MRIP_ACCESS_TOKEN_TTL_MINUTES=60

# --------------------------------------------------------------------- paths
# The blob store holds source documents byte-exact. It *is* the evidence, so it
# must be backed up together with the database.
# MRIP_DATA_DIR=/var/lib/mrip/data
# MRIP_BLOB_DIR=/var/lib/mrip/blobs

# ------------------------------------------------------------------- workers
MRIP_WORKER_CONCURRENCY=2
# Must exceed the longest plausible single-page OCR, or a live job's lease
# expires and another worker picks it up while the first is still running.
MRIP_JOB_LEASE_SECONDS=300

# ---------------------------------------------------------------- thresholds
# Facts whose *limiting* confidence (the weakest stage, not an average) falls
# below this go to the review queue instead of being treated as validated.
MRIP_REVIEW_CONFIDENCE_THRESHOLD=0.80
# Relative spread above which two sources disagreeing is material rather than a
# rounding difference. 0.005 = 0.5%.
MRIP_CONFLICT_MATERIAL_SPREAD=0.005

# ------------------------------------------------------------- observability
MRIP_LOG_LEVEL=INFO
# console | json — `prod` requires json.
MRIP_LOG_FORMAT=console

# ------------------------------------------------------------------- models
# Local inference only. There is deliberately no setting for a hosted provider:
# MRIP performs no inference off the deployment host, and the exact-figure path
# reaches no model at all. Setting MRIP_LLM_ENABLED=false must leave every
# deterministic path working — CI runs the suite both ways.
#
# This address is correct when the API runs on the host, and wrong inside a
# container, where 127.0.0.1 is the container rather than your machine. Under
# `docker compose` the model therefore lives at host.docker.internal; ./run.sh
# makes that substitution for you, so leave this as it is unless your model
# runtime is on another machine.
MRIP_LLM_BASE_URL=http://127.0.0.1:11434
# Qwen3 8B, Q4_K_M — 5.2 GB, Apache-2.0. `ollama pull qwen3:8b`
MRIP_LLM_MODEL=qwen3:8b
# Qwen3 reasons before answering unless told not to; the trace triples latency for
# prose that summarises figures already computed.
MRIP_LLM_THINKING=false
MRIP_LLM_TIMEOUT_SECONDS=60
MRIP_LLM_ENABLED=true
MRIP_LLM_KEEP_ALIVE=5m
MRIP_LLM_NUM_PREDICT=512
MRIP_LLM_NUM_CTX=2048
MRIP_LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------- web
# Read at runtime by the Next server, which proxies /api/* to it. The browser
# never learns this address.
MRIP_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------ host port maps
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
